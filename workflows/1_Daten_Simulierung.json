    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n\n    let temperatur =\n        Number(item.json.temperatur_c) *\n        (0.97 + Math.random() * 0.03);\n\n    let vibration =\n        Number(item.json.vibration_mm) *\n        (0.97 + Math.random() * 0.03);\n\n    let druck =\n        Number(item.json.druck_bar) *\n        (0.98 + Math.random() * 0.03);\n\n    let strom =\n        Number(item.json.stromaufnahme_a) *\n        (0.97 + Math.random() * 0.03);\n\n    let drehzahl =\n        Number(item.json.drehzahl_rpm) *\n        (0.97 + Math.random() * 0.03);\n\n    let ausfallrisiko =\n        Number(item.json.ausfallrisiko) *\n        (0.97 + Math.random() * 0.03);\n\n    // Nur 0,5% kritische Ereignisse\n    if (Math.random() < 0.005) {\n\n        temperatur += 8 + Math.random() * 8;\n        vibration += 1 + Math.random() * 2;\n        strom += 20 + Math.random() * 40;\n        ausfallrisiko += 10 + Math.random() * 10;\n    }\n\n    // Risiko begrenzen\n    ausfallrisiko = Math.min(ausfallrisiko, 100);\n\n    output.push({\n        json: {\n\n            produktionsauftrag_id:\n                item.json.produktionsauftrag_id,\n\n            maschinen_id:\n                item.json.maschinen_id,\n\n            temperatur_c:\n                Number(temperatur.toFixed(2)),\n\n            druck_bar:\n                Number(druck.toFixed(2)),\n\n            vibration_mm:\n                Number(vibration.toFixed(2)),\n\n            stromaufnahme_a:\n                Number(strom.toFixed(2)),\n\n            drehzahl_rpm:\n                Math.round(drehzahl),\n\n            ausfallrisiko:\n                Number(ausfallrisiko.toFixed(2)),\n\n            zeitstempel:\n                new Date().toISOString(),\n\n            ausfallrisiko_klasse:\n                ausfallrisiko > 85\n                    ? 'Hoch'\n                    : ausfallrisiko > 60\n                    ? 'Mittel'\n                    : 'Niedrig',\n\n            temperatur_status:\n                temperatur > 95\n                    ? 'Erhöht'\n                    : 'Normal',\n\n            vibration_status:\n                vibration > 8\n                    ? 'Kritisch'\n                    : 'Normal'\n        }\n    });\n}\n\nreturn output;"
      },
