    {
      "parameters": {
        "jsCode": "const alarms = $input.all();\n\nlet msg = `🚨 Produktionsalarm\\n\\n`;\nmsg += `Anzahl Alarme: ${alarms.length}\\n\\n`;\n\nconst kritisch = alarms.filter(a => a.json.schweregrad === 'Kritisch').length;\nconst hoch = alarms.filter(a => a.json.schweregrad === 'Hoch').length;\nconst mittel = alarms.filter(a => a.json.schweregrad === 'Mittel').length;\n\nmsg += `🔴 Kritisch: ${kritisch}\\n`;\nmsg += `🟠 Hoch: ${hoch}\\n`;\nmsg += `🟡 Mittel: ${mittel}\\n\\n`;\n\nfor (const alarm of alarms) {\n\n    msg += `━━━━━━━━━━━━━━\\n`;\n    msg += `Maschine: ${alarm.json.maschinen_id}\\n`;\n    msg += `Alarm: ${alarm.json.alarm_typ}\\n`;\n    msg += `Schweregrad: ${alarm.json.schweregrad}\\n`;\n\n    // Nachricht nur anzeigen wenn vorhanden\n    if (alarm.json.nachricht) {\n        msg += `Info: ${alarm.json.nachricht}\\n`;\n    }\n\n    msg += `\\n`;\n}\n\nreturn [{\n    json: {\n        slack_message: msg\n    }\n}];"
      },
