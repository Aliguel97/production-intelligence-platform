        "query": "SELECT\n    maschinen_id,\n    alarm_typ,\n    schweregrad,\n    COUNT(*) AS anzahl\nFROM prod.alarme\nWHERE zeitstempel >= NOW() - INTERVAL '3 hours'\nGROUP BY maschinen_id, alarm_typ, schweregrad\nORDER BY anzahl DESC\nLIMIT 10000;",
