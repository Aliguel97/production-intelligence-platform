      "id": "97619351-3acf-4edb-a980-6c0e2f30718b",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "jsCode": "const alarms = [];\n\nfor (const item of $input.all()) {\n\n    const temp = Number(item.json.temperatur_c);\n    const vibration = Number(item.json.vibration_mm);\n    const risiko = Number(item.json.ausfallrisiko);\n\n    let alarm_typ = '';\n    let schweregrad = '';\n    let nachricht = '';\n\n    if (temp > 100) {\n\n        alarm_typ = 'Temperaturalarm';\n        schweregrad = 'Kritisch';\n\n        nachricht =\n            `Maschine ${item.json.maschinen_id} überhitzt. Temperatur: ${temp}°C`;\n\n    } else if (vibration > 8) {\n\n        alarm_typ = 'Lagerschaden';\n        schweregrad = 'Hoch';\n\n        nachricht =\n            `Maschine ${item.json.maschinen_id} zeigt erhöhte Vibrationen. Vibration: ${vibration} mm`;\n\n    } else if (risiko > 90) {\n\n        alarm_typ = 'Wartung erforderlich';\n        schweregrad = 'Hoch';\n\n        nachricht =\n            `Maschine ${item.json.maschinen_id} weist ein hohes Ausfallrisiko auf. Risiko: ${risiko}%`;\n\n    } else if (temp > 85 || vibration > 6 || risiko > 75) {\n\n        alarm_typ = 'Warnung';\n        schweregrad = 'Mittel';\n\n        nachricht =\n            `Maschine ${item.json.maschinen_id} nähert sich kritischen Grenzwerten.`;\n\n    } else {\n\n        continue;\n    }\n\n    alarms.push({\n        json: {\n            zeitstempel: new Date().toISOString(),\n            maschinen_id: item.json.maschinen_id,\n            alarm_typ,\n            schweregrad,\n            nachricht\n        }\n    });\n\n}\n\nreturn alarms;"
      },
