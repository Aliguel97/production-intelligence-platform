    {
      "parameters": {
        "jsCode": "const auftraege = $input.all();\n\nlet msg = `🔧 *WARTUNGSAUFTRÄGE ERSTELLT*\\n\\n`;\n\nmsg += `📋 Anzahl Aufträge: ${auftraege.length}\\n\\n`;\n\nconst sofort = auftraege.filter(a => a.json.prioritaet === 'Sofort').length;\nconst hoch = auftraege.filter(a => a.json.prioritaet === 'Hoch').length;\n\nmsg += `🔴 Sofort: ${sofort}\\n`;\nmsg += `🟠 Hoch: ${hoch}\\n\\n`;\n\nfor (const a of auftraege) {\n\n    let emoji = \"🟠\";\n\n    if (a.json.prioritaet === \"Sofort\") {\n        emoji = \"🔴\";\n    }\n\n    msg += `${emoji} Maschine ${a.json.maschinen_id}\\n`;\n    msg += `   Alarm: ${a.json.alarm_typ}\\n`;\n    msg += `   Priorität: ${a.json.prioritaet}\\n`;\n    msg += `   Status: ${a.json.status}\\n\\n`;\n}\n\nmsg += `━━━━━━━━━━━━━━\\n`;\nmsg += `🤖 Automatisch durch n8n erstellt`;\n\nreturn [{\n    json: {\n        slack_message: msg\n    }\n}];"
      },
